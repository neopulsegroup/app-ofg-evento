# Variáveis para a Vercel (Project Settings > Environment Variables) ou .env local
ADMIN_KEY=gerar-uma-chave-longa
APP_SECRET=gerar-um-segredo-longo
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:eventos@oportofortegroup.com
# Preenchidas automaticamente ao ligar o Upstash Redis (Vercel Marketplace):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Email de recuperação de senha (https://resend.com). Sem isto, a recuperação falha em produção.
RESEND_API_KEY=
MAIL_FROM=OFG Recife <no-reply@seu-dominio.com>
# URL pública da app (usada no link do email); por omissão usa o host do pedido
# PUBLIC_URL=https://app.exemplo.com
