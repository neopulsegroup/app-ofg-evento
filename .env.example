# Variáveis (Vercel > Project Settings > Environment Variables; local: .env.local, ignorado pelo git)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_KEY=gerar-uma-chave-longa
APP_SECRET=gerar-um-segredo-longo
# Web Push (npm run vapid)
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:eventos@oportofortegroup.com
# Email de recuperação de senha (https://resend.com). Sem isto a recuperação falha em produção.
RESEND_API_KEY=
MAIL_FROM=OFG Recife <no-reply@seu-dominio.com>
# URL pública da app (link do email); por omissão usa o host do pedido
# PUBLIC_URL=https://app.exemplo.com
# e-mails que são admin automaticamente ao registar/entrar (separados por vírgula)
ADMIN_EMAILS=w.renato.menezes@gmail.com
